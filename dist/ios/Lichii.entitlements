<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debuggable so SideStore/StikJIT can enable the JIT (dynarmic needs RWX code pages). -->
	<key>get-task-allow</key>
	<true/>
	<!-- Switch 2 titles are given a 12 GB memory layout; lift the per-process limit. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<!-- The guest address space is reserved as one large mapping. -->
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
